<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img
        src="/img/mustang-logo-gold.png"
        alt="Mustang RideShare logo"
        class="me-2"
        style="height: 32px; width: auto;"
      />
      <span class="fw-bold text-dark">Mustang RideShare</span>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
      <ul class="navbar-nav mb-2 mb-lg-0">
        <% if (user && user.role === 'student') { %>
          <li class="nav-item">
            <a class="nav-link" href="/dashboard/student">Student</a>
          </li>
        <% } %>

        <% if (user && user.role === 'driver') { %>
          <li class="nav-item">
            <a class="nav-link" href="/dashboard/driver">Driver</a>
          </li>
        <% } %>

        <% if (user && user.role === 'admin') { %>
          <li class="nav-item">
            <a class="nav-link" href="/dashboard/admin">Admin</a>
          </li>
        <% } %>

        <% if (user) { %>
          <li class="nav-item">
            <span class="nav-link disabled">
              Welcome, <%= user.fullName || user.email %> !
            </span>
          </li>
          <li class="nav-item">
            <a class="nav-link text-danger" href="/logout">Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/login">Home</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-gold ms-2" href="/register">Get Started</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
