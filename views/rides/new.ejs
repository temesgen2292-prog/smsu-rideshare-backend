<%- include('../partials/head', { title: 'Post New Ride - Mustang RideShare' }) %>
<%- include('../partials/navbar') %>

<div class="container my-5">
  <h1 class="mb-3">Post a New Ride</h1>
  <p class="text-muted mb-4">
    Share a ride from SMSU to nearby cities so other Mustangs can join.
  </p>

  <div class="card shadow-sm">
    <div class="card-body">
      <form action="/rides/new" method="POST" class="card p-3 shadow-sm">
        <div class="row g-3">
          
          <!-- FROM -->
          <div class="col-md-6">
            <label class="form-label">From</label>
            <input
              type="text"
              name="from"
              class="form-control"
              placeholder="SMSU Campus"
              required
            />
          </div>

          <!-- TO -->
          <div class="col-md-6">
            <label class="form-label">To</label>
            <input
              type="text"
              name="to"
              class="form-control"
              placeholder="Sioux Falls"
              required
            />
          </div>

          <!-- DATE -->
          <div class="col-md-4">
            <label class="form-label">Date</label>
            <input
              type="date"
              name="date"
              class="form-control"
              required
            />
          </div>

          <!-- TIME -->
          <div class="col-md-4">
            <label class="form-label">Time</label>
            <input
              type="time"
              name="time"
              class="form-control"
              required
            />
          </div>

          <!-- SEATS -->
          <div class="col-md-4">
            <label class="form-label">Available Seats</label>
            <input
              type="number"
              name="seats"
              min="1"
              max="8"
              value="3"
              class="form-control"
              required
            />
          </div>

          <!-- NOTES -->
          <div class="col-12">
            <label class="form-label">Notes for passengers</label>
            <textarea
              name="notes"
              class="form-control"
              rows="3"
              placeholder="e.g. Leaving from Central Field parking lot, please be 10 minutes early."
            ></textarea>
          </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <a href="/dashboard/driver" class="btn btn-outline-secondary">Cancel</a>
          <button type="submit" class="btn btn-gold">Post Ride</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
