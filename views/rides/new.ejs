<%- include('../partials/head', { title: 'Post New Ride - Mustang RideShare' }) %>
<%- include('../partials/navbar') %>

<div class="container my-5">
  <h1 class="mb-3">Post a New Ride</h1>
  <p class="text-muted mb-4">
    Share a ride from SMSU to nearby cities so other Mustangs can join.
  </p>

  <!-- For now this is just a front-end form; we'll wire it to the DB later -->
  <div class="card shadow-sm">
    <div class="card-body">
      <form>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">From</label>
            <input
              type="text"
              class="form-control"
              placeholder="SMSU Campus"
              required
            />
          </div>
          <div class="col-md-6">
            <label class="form-label">To</label>
            <input
              type="text"
              class="form-control"
              placeholder="Sioux Falls"
              required
            />
          </div>

          <div class="col-md-4">
            <label class="form-label">Date</label>
            <input type="date" class="form-control" required />
          </div>

          <div class="col-md-4">
            <label class="form-label">Time</label>
            <input type="time" class="form-control" required />
          </div>

          <div class="col-md-4">
            <label class="form-label">Available Seats</label>
            <input
              type="number"
              min="1"
              max="8"
              value="3"
              class="form-control"
              required
            />
          </div>

          <div class="col-12">
            <label class="form-label">Notes for passengers</label>
            <textarea
              class="form-control"
              rows="3"
              placeholder="e.g. Leaving from Central Field parking lot, please be 10 minutes early."
            ></textarea>
          </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <a href="/dashboard/driver" class="btn btn-outline-secondary">
            Cancel
          </a>
          <button type="button" class="btn btn-gold">
            Save (demo only)
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
