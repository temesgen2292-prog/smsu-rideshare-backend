<%- include('../partials/head', { title: 'Driver Dashboard - Mustang RideShare' }) %>
<%- include('../partials/navbar') %>

<div class="container my-5">
  <h1 class="mb-3">Driver Dashboard</h1>
  <p class="text-muted mb-4">
    Manage your active rides, incoming requests, and recent passenger messages.
  </p>

  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card summary-card">
        <div class="card-body text-center">
          <div class="summary-label">Active Rides</div>
          <div class="summary-value">4</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card summary-card">
        <div class="card-body text-center">
          <div class="summary-label">Pending Requests</div>
          <div class="summary-value text-warning">3</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card summary-card">
        <div class="card-body text-center">
          <div class="summary-label">Seats Filled</div>
          <div class="summary-value text-success">9 / 12</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card mb-4">
        <div
          class="card-header d-flex justify-content-between align-items-center"
        >
          <h5 class="mb-0">My Active Rides</h5>
          <!-- ✅ Turned into a link that goes to /rides/new -->
          <a href="/rides/new" class="btn btn-gold btn-sm">
            Post New Ride
          </a>
        </div>
        <div class="card-body p-0">
          <table class="table mb-0">
            <thead>
              <tr>
                <th>Route</th>
                <th>Date &amp; Time</th>
                <th>Seats</th>
                <th>Requests</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Marshall → Sioux Falls</td>
                <td>Today · 5:30 PM</td>
                <td>1/3 left</td>
                <td>2</td>
              </tr>
              <tr>
                <td>Campus → Walmart</td>
                <td>Thu · 7:00 PM</td>
                <td>2/4 left</td>
                <td>1</td>
              </tr>
              <tr>
                <td>Marshall → Minneapolis</td>
                <td>Fri · 2:00 PM</td>
                <td>0/3 left</td>
                <td>3</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Incoming Ride Requests</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <p class="mb-1">
              <strong>Student:</strong> Dani M.<br />
              <strong>Ride:</strong> Marshall → Sioux Falls
            </p>
            <p class="mb-1 text-muted fst-italic">
              "I need to catch a 7 PM flight, can I join?"
            </p>
            <span class="badge rounded-pill bg-warning text-dark">Pending</span>
          </div>

          <hr />

          <div class="mb-3">
            <p class="mb-1">
              <strong>Student:</strong> Amanuel T.<br />
              <strong>Ride:</strong> Campus → Walmart
            </p>
            <p class="mb-1 text-muted fst-italic">
              "Can we stop by CVS on the way back?"
            </p>
            <span class="badge rounded-pill bg-success">Accepted</span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Recent Passenger Messages</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <p class="mb-1">
              <strong>From Dani:</strong>
              <span class="fst-italic">
                "I'll be at the Student Center entrance at 5:20."
              </span>
            </p>
          </div>

          <hr />

          <div class="mb-0">
            <p class="mb-1">
              <strong>From Amanuel:</strong>
              <span class="fst-italic">
                "Thanks again for the ride yesterday!"
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
